# Copy this file to ".env" and fill in your values

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/slotbooking
# MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/slotbooking?retryWrites=true&w=majority

PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
